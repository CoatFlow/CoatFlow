# ============================================================================
# CoatFlow — Supabase configuratie (VOORBEELD)
# ----------------------------------------------------------------------------
# Kopieer dit bestand naar  .streamlit/secrets.toml  en vul je echte waarden in.
# Zet NOOIT echte keys in versiebeheer of in een chat. .streamlit/secrets.toml
# hoort in .gitignore.
#
# Waar vind je deze waarden?
#   Supabase dashboard → Project Settings → API
#     - Project URL          → supabase_url
#     - service_role secret  → supabase_service_key   (Fase 1: app draait single-user)
#     - anon public          → supabase_anon_key       (pas nodig vanaf Fase 2 login)
#   default_company_id wordt geprint door migrate_json_to_supabase.py.
#
# Zolang dit bestand ONTBREEKT of leeg is, blijft de app op lokale JSON draaien
# (geen crash). Zodra het is ingevuld, is Supabase de primaire opslag.
# ============================================================================

[supabase]
supabase_url         = "https://JOUW-PROJECT.supabase.co"
supabase_service_key = "JOUW-SERVICE-ROLE-KEY"
supabase_anon_key    = ""                     # Fase 2
default_company_id   = "JOUW-COMPANY-UUID"    # uit migrate_json_to_supabase.py
