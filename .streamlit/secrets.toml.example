# ============================================================================
# CoatFlow — Supabase configuratie (VOORBEELD)
# ----------------------------------------------------------------------------
# Kopieer dit bestand naar  .streamlit/secrets.toml  en vul je echte waarden in.
# Zet NOOIT echte keys in versiebeheer of in een chat. .streamlit/secrets.toml
# hoort in .gitignore.
#
# Waar vind je deze waarden?
#   Supabase dashboard → Project Settings → API
#     - Project URL          → supabase_url
#     - service_role secret  → supabase_service_key   (server-side data-toegang)
#     - anon public          → supabase_anon_key      (VERPLICHT: login draait hierop)
#
# Zolang dit bestand ONTBREEKT of leeg is, blijft de app op lokale JSON draaien
# ZONDER login (geen crash) — handig voor snelle UI-dev. Zodra url + keys zijn
# ingevuld draait de app in Supabase-modus MÉT login (zoals productie).
#
# TIP: gebruik hier een APART dev/staging Supabase-project, NIET productie.
# Zie DEV_SETUP.md. (default_company_id is niet meer nodig — verwijderd sinds de
# data-isolatie-fix waarbij elke gebruiker een eigen, leeg bedrijf krijgt.)
# ============================================================================

[supabase]
supabase_url         = "https://JOUW-DEV-PROJECT.supabase.co"
supabase_service_key = "JOUW-SERVICE-ROLE-KEY"
supabase_anon_key    = "JOUW-ANON-PUBLIC-KEY"
