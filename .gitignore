# ─────────────────────────────────────────────────────────────
# CoatFlow — .gitignore
# NOOIT committen: echte secrets & klantdata. Deze horen op
# Streamlit Cloud in de Secrets-manager, niet in de repo.
# ─────────────────────────────────────────────────────────────

# Secrets & credentials (ECHTE Supabase-keys) — NOOIT naar GitHub
.streamlit/secrets.toml
secrets.toml
*.env
.env
# (secrets.toml.example is een leeg sjabloon en mag wél mee)

# Echte bedrijfs-/klantdata (privacy/AVG) — Supabase is de productie-opslag
data/
appdata.json

# Ontwikkel-screenshots (kunnen echte klantnamen/adressen tonen) & losse
# wegwerp-testscripts los in de repo-root (NIET de echte testsuite in tests/,
# zie de uitzondering hieronder — test_*.py matcht anders op elke diepte).
*.png
test_*.py
verify_*.py
debug_*.py
screenshot_*.py
zoom_*.py
inspect_*.py
check_overlap.py
!tests/test_*.py

# Testsuite build-artefact
.pytest_cache/

# Python-caches & virtuele omgevingen
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Lokale/agent-artefacten
.preview_tmp/
.claude/
.DS_Store
Thumbs.db
